GROQ_API_KEY=your-groq-key-here
GROQ_MODEL=llama-3.1-8b-instant
PORT=3001

# Optional: DeepSeek acts as (1) a fallback if Groq fails entirely, and
# (2) a second opinion that deepens explanations and double-checks grading
# on wrong/partial answers. The app works fine without this - it just
# skips the enhancement step if no key is set.
DEEPSEEK_API_KEY=your-deepseek-key-here
DEEPSEEK_MODEL=deepseek-chat
